MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/devices]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Devices

[scalable/mimetypes]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes
