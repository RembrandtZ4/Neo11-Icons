[Icon Theme]
Name=Neo11 Silber
Comment=Weiß-silberne Programmsymbole passend zu Neo11Menu (Symbolgröße 90 %)
Inherits=breeze-dark,breeze,hicolor
Example=folder
DisplayDepth=32
Directories=scalable/apps,scalable/places,scalable/devices,scalable/mimetypes

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
